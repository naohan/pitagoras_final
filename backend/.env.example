DATABASE_URL=mysql+pymysql://pitagoras:pitagoras@localhost:3307/pitagoras

# Auth / JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# RAG / ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=pitagoras_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# LLM / Tutor IA
# gemini: API directa de Google AI Studio (GOOGLE_API_KEY o GEMINI_API_KEY, formato AIza...)
# openrouter: OPENAI_API_KEY=sk-or-v1-... y OPENAI_MODEL=openrouter/google/gemini-2.0-flash-001
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=openrouter/google/gemini-2.0-flash-001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TUTOR_RAG_TOP_K=3
GOOGLE_API_KEY=

# === 3 agentes (diagnóstico / motivador-Cachimbito / padres) ===
# compact = briefing + 1 llamada (menos tokens) | full = ADK tools | rules = 0 tokens
AGENT_EXECUTION_MODE=compact
USE_LLM_FOR_DIAGNOSTIC=true
USE_LLM_FOR_MOTIVATOR=true
USE_LLM_FOR_PARENTS=true
AGENT_CACHE_TTL_SECONDS=3600
AGENT_BRIEF_MAX_ITEMS=3
AGENT_RAG_TOP_K=2
AGENT_RAG_FRAGMENT_CHARS=160
AGENT_MAX_OUTPUT_TOKENS=220
AGENT_MAX_OUTPUT_CHARS=900

# CORS: orígenes extra (coma-separados). localhost/127.0.0.1:any ya están permitidos.
# CORS_ORIGINS=
